@model FitManager.Models.Socio

@{
    ViewData["Title"] = "Details";
}

<h1 class="mb-4">Detalle del socio</h1>

<div class="card bg-light mb-4">
    <div class="card-header">
        <h5 class="mb-0">Información personal</h5>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Nombre)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Nombre)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Apellido)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Apellido)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Dni)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Dni)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Telefono)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Telefono)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Email)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Email)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FechaIngreso)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.FechaIngreso)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Localidad)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Localidad)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Domicilio)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Domicilio)</dd>

            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Activo)</dt>
            <dd class="col-sm-9">
                @if (Model.Activo)
                {
                    <span class="text-success fw-bold">Activo</span>
                }
                else
                {
                    <span class="text-danger fw-bold">Inactivo</span>
                }
            </dd>
        </dl>
    </div>
</div>

<div class="card bg-light mb-4">
    <div class="card-header">
        <h5 class="mb-0">Actividades del socio</h5>
    </div>
    <div class="card-body">
        @if (Model.SocioActividades != null && Model.SocioActividades.Any())
        {
            <ul class="mb-0">
                @foreach (var sa in Model.SocioActividades)
                {
                    <li>@sa.Actividad.Nombre - @sa.DiasPorSemana día(s) por semana</li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">Este socio no está registrado en ninguna actividad.</p>
        }
    </div>
</div>

<div class="d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
</div>