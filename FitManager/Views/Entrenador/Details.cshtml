@model FitManager.Models.Entrenador

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Entrenador</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Apellido)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Apellido)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class = "col-sm-10">
            @Model.SueldoMensual.ToString("N2", new System.Globalization.CultureInfo("es-AR"))
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SueldoMensual)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SueldoMensual)
        </dd>
    </dl>
    <h4>Actividades que dicta</h4>
    <td>
        @if (Model.EntrenadorActividades != null && Model.EntrenadorActividades.Any())
        {
            @string.Join(", ", Model.EntrenadorActividades.Select(ea => ea.Actividad?.Nombre ?? ""))
        }
        else
        {
            <span class="text-muted">Sin actividades</span>
        }
    </td>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Editar</a> |
    <a asp-action="Index">Volver</a>
</div>
