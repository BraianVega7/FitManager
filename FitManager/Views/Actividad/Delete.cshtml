@model FitManager.Models.Actividad

@{
    ViewData["Title"] = "Eliminar Actividad";
}

<div class="card-fit">
    <div class="card-fit-header mb-3">
        <h2>Eliminar Actividad</h2>
    </div>

    <h5 class="text-danger">¿Estás seguro de que querés eliminar esta actividad?</h5>
    <hr />

    <dl class="row">
        <dt class="col-sm-3 fw-semibold">
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Nombre)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger me-2">Eliminar</button>
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </form>
</div>